# Copy to .env, edit, then: set -a; source .env; set +a
# Keep credentials out of this file. Existing gh and Codex logins are used.
GITHUB_REPOSITORY=PetStorePro/petstore
GITHUB_ISSUE_LABEL=ai-ready
AI_DEVELOPER_PROVIDER=codex
AI_REVIEWER_PROVIDER=codex
REQUIRED_CHECKS=ci,security
FACTORY_RUNTIME="$HOME/.software-factory/m1"
POLL_INTERVAL_SECONDS=30
AGENT_TIMEOUT_SECONDS=600
CI_TIMEOUT_SECONDS=1800
MAX_CI_FIX_ATTEMPTS=2
MAX_REVIEW_CYCLES=3
