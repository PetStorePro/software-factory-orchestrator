# Copy to .env, edit, then: set -a; source .env; set +a
# Keep credentials out of this file. Existing gh and Codex logins are used.
GITHUB_REPOSITORY=PetStorePro/pet-store-web-app
# CI workflows run for pull requests targeting main.
BASE_BRANCH=main
GITHUB_ISSUE_LABEL=ai-ready
AI_DEVELOPER_PROVIDER=codex
AI_REVIEWER_PROVIDER=codex
REQUIRED_CHECKS=backend,frontend,dependency-review,backend-image,frontend-image
# Test/demo only: skip CI only when no checks and no workflow YAML files exist.
ALLOW_MISSING_CI=false
FACTORY_RUNTIME="$HOME/.software-factory/petstore-scaffold-test"
POLL_INTERVAL_SECONDS=30
AGENT_TIMEOUT_SECONDS=600
CI_TIMEOUT_SECONDS=1800
MAX_CI_FIX_ATTEMPTS=2
MAX_REVIEW_CYCLES=3
